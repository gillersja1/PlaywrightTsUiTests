{
  "name": "playwright-ts-ui-tests",
  "version": "1.0.0",
  "description": "UI test automation example using TypeScript and Playwright Test",
  "private": true,
  "scripts": {
    "test": "playwright test --config=playwright.config.ts",
    "test:headed": "playwright test --headed --config=playwright.config.ts",
    "test:ui": "playwright test --ui --config=playwright.config.ts",
    "test:debug": "playwright test --debug --config=playwright.config.ts",
    "test:chromium": "playwright test --project=chromium --config=playwright.config.ts",
    "report": "playwright show-report",
    "install:browsers": "playwright install --with-deps"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
